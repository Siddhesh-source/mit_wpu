# API
PORT=4000
JWT_SECRET=change-me
DB_PATH=apps/api/data/app.sqlite
STORAGE_DIR=apps/api/storage
# Ed25519 issuer key, hex. Generated once and kept in the database if empty.
ISSUER_PRIVATE_KEY=
# Base URL printed into QR codes (use your LAN IP so phones can reach it, e.g. http://192.168.1.20:5173)
PUBLIC_BASE_URL=http://localhost:5173
# Chain: local (Hardhat node started by `npm run dev`), amoy (Polygon Amoy testnet) or off
CHAIN_MODE=local
CHAIN_RPC_URL=http://127.0.0.1:8545
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Funded Amoy test wallet (free test POL from a faucet). Never a real-money key.
AMOY_PRIVATE_KEY=
# Issuing college id written on chain with every seal (max 31 chars)
COLLEGE_ID=COLLEGE-001
# Uploads (attachments): max size per file in MB
MAX_UPLOAD_MB=5
# Demo only: count every step deadline (SLA) as this many minutes instead of hours
SLA_MINUTES=
# Email: log (default, shows in Admin -> Emails) | ses (AWS SES) | off. See docs/EMAIL_SES.md
EMAIL_PROVIDER=log
EMAIL_FROM=PaperLess Campus <no-reply@campus.example>
SES_REGION=ap-south-1
# Send every email to one address (SES sandbox / demos)
EMAIL_REDIRECT_ALL=
