[Unit]
Description=PaperLess Campus (API + web app)
After=network-online.target paperless-chain.service
Wants=network-online.target

[Service]
User=paperless
WorkingDirectory=/opt/paperless
EnvironmentFile=/opt/paperless/.env
Environment=NODE_OPTIONS=--max-old-space-size=384
# Run the server directly (no npm wrapper process): saves ~40 MB on a micro instance.
ExecStart=/opt/paperless/node_modules/.bin/tsx /opt/paperless/apps/api/src/server.ts
Restart=always
RestartSec=3
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paperless /opt/paperless
PrivateTmp=true

[Install]
WantedBy=multi-user.target
